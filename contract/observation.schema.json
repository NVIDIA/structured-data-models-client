{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sdm:observation:1",
  "title": "Contract observation",
  "description": "What one runner observed of one case, one JSON object per line of a runner's output. identity is validated on its own and never compared as a field. A field a runner cannot observe is null, never filled in: rust-host has no stage, exception class or host section, and python-old and python-ref have no core section. No message text is recorded.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "case", "identity", "outcome", "host", "core"],
  "properties": {
    "format": {"const": "sdm-observation/1"},
    "case": {"$ref": "urn:sdm:case:1#/$defs/id"},
    "identity": {"$ref": "#/$defs/identity"},
    "outcome": {
      "description": "Where the public call ended. For rust-host, which makes no public call, the outcome is the core's answer as the route maps it: an accepted query, a description or a materialized request is a success, a refused query INVALID_REQUEST, and a core error a refusal with its code.",
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "stage", "error", "code"],
      "properties": {
        "result": {"enum": ["success", "refusal"]},
        "stage": {"enum": ["from_source", "materialize", "predict", null]},
        "error": {"type": ["string", "null"], "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "code": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]*$"}
      }
    },
    "host": {
      "description": "Python runners only: warning classes in the order shown, for information.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["warnings"],
      "properties": {
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "driver": {
      "description": "Python runners only (rust-host writes none): the test-only driver capture (design, Driver capture; decision Q2) and DuckDB's own query log, read after the case. capture is null when the run handed the source the driver connection itself (the conservation control). Setup, everything run before the connection reaches Schema.from_source, is in neither.",
      "type": "object",
      "additionalProperties": false,
      "required": ["capture", "query_log"],
      "properties": {
        "capture": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["statements", "bindings", "events", "incomplete", "passed_through", "cursors"],
          "properties": {
            "statements": {
              "description": "Each statement the driver ran, in order: the handle it ran on (0 the connection the source was given, then each derived cursor in the order made), its SQL text, its typed parameters, every result read from it and the class of any error it raised.",
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["handle", "sql", "parameters", "results", "error"],
                "properties": {
                  "handle": {"type": "integer", "minimum": 0},
                  "sql": {"type": ["string", "null"]},
                  "parameters": {"type": ["array", "null"], "items": {"$ref": "#/$defs/parameter"}},
                  "results": {"type": "array", "items": {"$ref": "#/$defs/result"}},
                  "error": {"type": ["string", "null"]}
                }
              }
            },
            "bindings": {
              "description": "Each relation the provider bound by name (DuckDB's register), with its Arrow contents.",
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["handle", "name", "type"],
                "properties": {
                  "handle": {"type": "integer", "minimum": 0},
                  "name": {"type": "string"},
                  "type": {"type": "string"},
                  "rows": {"type": "integer", "minimum": 0},
                  "schema": {"$ref": "#/$defs/arrow_schema"},
                  "digest": {"$ref": "#/$defs/sha256"}
                }
              }
            },
            "events": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["event", "handle"],
                "properties": {
                  "event": {"enum": ["cursor", "close", "commit", "rollback", "begin", "exit", "unregister"]},
                  "handle": {"type": "integer", "minimum": 0},
                  "name": {"type": "string"}
                }
              }
            },
            "incomplete": {"description": "What the capture could not record; any entry fails the capture's checks.", "type": "array", "items": {"type": "string"}},
            "passed_through": {"description": "Attributes read from the driver that the capture neither records nor needs to.", "type": "array", "items": {"type": "string"}},
            "cursors": {"type": "integer", "minimum": 0}
          }
        },
        "query_log": {
          "description": "How many QueryLog entries DuckDB wrote after setup: statements (with text) and relations bound through the API (without). Their text is not kept: DuckDB rewrites some statements (a PRAGMA as its table function), and binding names are execution-scoped.",
          "type": "object",
          "additionalProperties": false,
          "required": ["statements", "bindings", "compared", "differing"],
          "properties": {
            "statements": {"type": "integer", "minimum": 0},
            "bindings": {"type": "integer", "minimum": 0},
            "compared": {"description": "How many captured statements' text was compared with the text DuckDB logged for it: all but a PRAGMA, which DuckDB logs as its table function; 0 without the capture.", "type": "integer", "minimum": 0},
            "differing": {"description": "The positions of compared statements whose logged text differs from the captured one.", "type": "array", "items": {"type": "integer", "minimum": 0}}
          }
        }
      }
    },
    "public": {
      "description": "Python runners only: the public projection the capture must not change (design, Driver capture): the public Schema, each request the scripted endpoint received, and the public result through to_pandas(). Warnings and the error outcome are host.warnings and outcome.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "payloads", "result"],
      "properties": {
        "schema": {"type": ["object", "null"]},
        "payloads": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "path", "sha256", "parsed"],
            "properties": {
              "method": {"type": "string"},
              "path": {"type": "string"},
              "sha256": {"$ref": "#/$defs/sha256"},
              "parsed": {"description": "The body as JSON, every number as {\"number\": its text}; null when it is not JSON."}
            }
          }
        },
        "result": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["columns", "rows", "digest"],
          "properties": {
            "columns": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "dtype"],
                "properties": {"name": {"type": "string"}, "dtype": {"type": "string"}}
              }
            },
            "rows": {"type": "integer", "minimum": 0},
            "digest": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "core": {
      "description": "python-core and rust-host only: the inputs each core operation was started with, every fetch the core asked for (its request and the plan its data layer made, in order: the step trace), and its answers: validate_query's acceptance, describe_source's description, materialize's request state, predict's call and result, or the core error's kind and code.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["inputs", "fetches", "accepted", "described", "materialized", "predicted", "error"],
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["op", "query", "profile", "schema"],
                "properties": {
                  "op": {"const": "validate_query"},
                  "query": {"type": "string"},
                  "profile": {"type": "object"},
                  "schema": {"type": "object"}
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["op", "provider", "source", "check_keys"],
                "properties": {
                  "op": {"const": "describe_source"},
                  "provider": {"type": "object"},
                  "source": {"description": "The contract's SourceSpec.", "type": "object"},
                  "check_keys": {"type": "boolean"}
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["op", "provider", "schema", "query", "indices", "anchor_time", "seed"],
                "properties": {
                  "op": {"const": "materialize"},
                  "provider": {"type": "object"},
                  "schema": {"description": "The contract's SourceDescription.", "type": "object"},
                  "query": {"type": "string"},
                  "indices": {"description": "One Arrow column, each value a contract scalar.", "type": ["array", "null"], "items": {"type": "object"}},
                  "anchor_time": {"type": ["object", "null"]},
                  "seed": {"type": ["string", "null"]}
                }
              },
              {
                "description": "predict's start: the model, and the request state the host handed back, its payload with each number as {\"number\": text}. The request id the host drew is recorded where it reaches the endpoint, in predicted.body's metadata.request_id, which the host checks is the one it started with.",
                "type": "object",
                "additionalProperties": false,
                "required": ["op", "model", "state"],
                "properties": {
                  "op": {"const": "predict"},
                  "model": {"type": "string"},
                  "state": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["version", "query", "payload"],
                    "properties": {
                      "version": {"type": "integer"},
                      "query": {"type": "string"},
                      "payload": {"type": "object"}
                    }
                  }
                }
              }
            ]
          }
        },
        "fetches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["request", "plan"],
            "properties": {"request": {"type": "object"}, "plan": {"type": "object"}}
          }
        },
        "accepted": {"type": ["boolean", "null"]},
        "described": {
          "description": "describe_source's SourceDescription, as the JSON the core attached.",
          "type": ["object", "null"]
        },
        "materialized": {
          "description": "materialize's RequestState: its version, the query as the core wrote it back, and the payload as the JSON the core attached, each number as {\"number\": text}, the text the core wrote.",
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["version", "query", "payload"],
          "properties": {
            "version": {"type": "integer"},
            "query": {"type": "string"},
            "payload": {"type": "object"}
          }
        },
        "predicted": {
          "description": "predict's answer: the model call's body as the core wrote it, each number as {\"number\": text}; the model and call id the endpoint named and its metadata; and the result, its columns and its rows in the endpoint's order, each cell {\"i64\": digits}, {\"f64_bits\": the float's IEEE-754 bits as 16 hex digits} or {\"utf8\": text}.",
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["body", "model", "request_id", "metadata", "result"],
          "properties": {
            "body": {"type": "object"},
            "model": {"type": "string"},
            "request_id": {"type": "string"},
            "metadata": {"type": "object"},
            "result": {
              "type": "object",
              "additionalProperties": false,
              "required": ["columns", "rows"],
              "properties": {
                "columns": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "type"], "properties": {"name": {"type": "string"}, "type": {"type": "string"}}}},
                "rows": {"type": "array", "items": {"type": "array"}}
              }
            }
          }
        },
        "error": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["kind", "code"],
          "properties": {
            "kind": {"type": "string", "pattern": "^[a-z_]+$"},
            "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "typed": {
      "description": "A value the capture recorded, as its Python type and repr: the capture's own text, never compared as a value.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {"type": {"type": "string"}, "value": {"type": "string"}}
    },
    "parameter": {
      "description": "A statement's parameter: typed, with its name when the statement binds parameters by name.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {"name": {"type": "string"}, "type": {"type": "string"}, "value": {"type": "string"}}
    },
    "arrow_schema": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {"name": {"type": "string"}, "type": {"type": "string"}}
      }
    },
    "result": {
      "description": "One read of a statement's result: the method, the rows it gave, their Arrow schema when it gave Arrow, and their digest (batch boundaries left out).",
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "rows", "digest"],
      "properties": {
        "method": {"type": "string"},
        "rows": {"type": "integer", "minimum": 0},
        "schema": {"$ref": "#/$defs/arrow_schema"},
        "digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "clean"],
      "properties": {
        "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "clean": {"type": "boolean"}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner", "cell", "platform", "commit", "reference", "native", "native_loaded", "operations", "contract", "versions", "inputs"],
      "properties": {
        "runner": {"enum": ["python-ref", "python-core", "python-old", "rust-host"]},
        "cell": {
          "description": "The runtime cell (design, Runtime cells) whose versions the runner's environment has exactly, or null when it has none's.",
          "enum": ["ref-pandas3", "dbr17-pandas2", "floor-pandas2.2", null]
        },
        "platform": {"type": "string", "minLength": 1},
        "commit": {"description": "The checkout the runner ran from.", "$ref": "#/$defs/commit"},
        "reference": {
          "description": "python-ref only: the reference checkout, its environment's hash and the guard's result before the first case and after the last.",
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["commit", "environment", "guard"],
          "properties": {
            "commit": {"$ref": "#/$defs/commit"},
            "environment": {"$ref": "#/$defs/sha256"},
            "guard": {
              "type": "object",
              "additionalProperties": false,
              "required": ["before", "after"],
              "properties": {
                "before": {"const": "passed"},
                "after": {"const": "passed"}
              }
            }
          }
        },
        "native": {
          "description": "python-core only: the SHA-256 of the sdm_client._native extension module it ran.",
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["sha256"],
          "properties": {"sha256": {"$ref": "#/$defs/sha256"}}
        },
        "native_loaded": {
          "description": "Python runners: whether sdm_client._native was in sys.modules after the case; null for rust-host.",
          "type": ["boolean", "null"]
        },
        "operations": {
          "description": "The HostRun operations the case started, in order.",
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z_]+$"}
        },
        "contract": {"description": "The contract version of the core it ran, or null.", "type": ["integer", "null"]},
        "versions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["duckdb"],
          "properties": {
            "python": {"type": "string"},
            "pandas": {"type": "string"},
            "pyarrow": {"type": "string"},
            "numpy": {"type": "string"},
            "duckdb": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+"}
          }
        },
        "inputs": {
          "description": "SHA-256 of the case file's bytes, and of contract/bases.yaml when the runner read it.",
          "type": "object",
          "additionalProperties": false,
          "required": ["case", "bases"],
          "properties": {
            "case": {"$ref": "#/$defs/sha256"},
            "bases": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
          }
        }
      }
    }
  }
}
