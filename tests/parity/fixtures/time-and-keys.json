  {
   "id": "time-and-keys/schema.from_data/stype-timestamp-sets-time-column",
   "source": "packages/structured-data-models-client/tests/test_inferred_time_and_keys.py",
   "operation": "schema.from_data",
   "input": {
    "tables": {
     "review": {
      "columns": {
       "rid": {
        "dtype": "int64",
        "values": [
         1,
         2,
         3
        ]
       },
       "date": {
        "dtype": "str",
        "values": [
         "2021-01-01",
         "2021-02-01",
         "2021-03-01"
        ]
       }
      }
     }
    },
    "edits": [
     {
      "table": "review",
      "column": "date",
      "set": "stype",
      "value": "timestamp"
     }
    ]
   },
   "expected": {
    "tables": {
     "review": {
      "primary_key": "rid",
      "time_column": "date",
      "columns": {
       "rid": {
        "dtype": "int64",
        "stype": "ID"
       },
       "date": {
        "dtype": "string",
        "stype": "timestamp"
       }
      }
     }
    },
    "relationships": [],
    "warnings": [
     "review.date holds dates but is stored as text, so it is not the time column and no temporal query can use it. Convert it before inferring: frame['date'] = pd.to_datetime(frame['date']), or set schema['review']['date'].stype = 'timestamp' afterwards."
    ]
   },
   "expected_warnings": []
  },
