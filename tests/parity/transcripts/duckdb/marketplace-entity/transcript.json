   "sql": "WITH __kumo_keys__ AS (\n  SELECT k.i - 1 AS __kumo_batch__, k.v.f0 AS __kumo_id__\n  FROM unnest(from_json(?, '[{\"f0\":\"BIGINT\"}]'))\n    WITH ORDINALITY AS k(v, i)\n)\nSELECT tmp.__kumo_batch__, COUNT(*) OVER (PARTITION BY tmp.__kumo_batch__) AS __kumo_matches__, \"customer_id\", \"signup_at\"\nFROM __kumo_keys__ tmp\nJOIN \"customers\"\n  ON \"customer_id\" = tmp.__kumo_id__\nQUALIFY ROW_NUMBER() OVER (\n  PARTITION BY tmp.__kumo_batch__\n  ORDER BY \"customer_id\", \"signup_at\"\n) = 1",
